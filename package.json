{
  "name": "shopping-list",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "electron:dev": "concurrently -k \"vite --host\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "cap:sync": "npm run build && cap sync",
    "test": "vitest run",
    "android:build": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "8.0.1",
    "@supabase/supabase-js": "2.118.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "jsdom": "30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "5.0.5",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.mjacopoleo.shoppinglist",
    "productName": "Courses",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
